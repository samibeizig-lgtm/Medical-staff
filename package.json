{
  "name": "medical-staff",
  "version": "2.0.0",
  "private": true,
  "description": "Medical Staff – plateforme tunisienne de recrutement médical et paramédical (Cloudflare Workers + D1)",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "check": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply medical-staff --local",
    "db:migrate:remote": "wrangler d1 migrations apply medical-staff --remote",
    "seed:local": "node --experimental-strip-types --no-warnings scripts/seed.ts --local",
    "seed:remote": "node --experimental-strip-types --no-warnings scripts/seed.ts --remote",
    "admin:local": "node --experimental-strip-types --no-warnings scripts/create-admin.ts --local",
    "admin:remote": "node --experimental-strip-types --no-warnings scripts/create-admin.ts --remote",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261005.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.147.0"
  },
  "engines": {
    "node": ">=22.6"
  }
}
